// =====================================================================
// MULTI-TENANT PHOTOBOOTH MANAGEMENT PLATFORM
// Database Schema (DBML) - Production Ready - MySQL 8 - 3NF
// Stack: Laravel 12 + Sanctum, React/Electron, Cloudflare R2, Midtrans
// =====================================================================

Project photobooth_saas {
  database_type: 'MySQL'
  Note: 'Multi-Tenant Photobooth Management Platform - Core Schema'
}

// =====================================================================
// ENUMS
// =====================================================================

Enum partner_status {
  active
  suspended
  trial
  inactive
}

Enum subscription_status {
  active
  expired
  cancelled
  pending
}

Enum booth_status {
  active
  maintenance
  inactive
}

Enum device_status {
  pending
  active
  blocked
  revoked
}

Enum event_status {
  draft
  scheduled
  ongoing
  completed
  cancelled
}

Enum template_status {
  draft
  active
  archived
}

Enum voucher_status {
  unused
  redeemed
  expired
  void
}

Enum payment_gateway {
  midtrans_qris
  voucher
  cash
  other
}

Enum payment_status {
  pending
  paid
  failed
  expired
  refunded
}

Enum session_status {
  started
  processing
  completed
  failed
  cancelled
}

Enum media_type {
  original
  edited
  template
  gif
  video
  thumbnail
  qr
  zip
  ai_generated
}

Enum media_visibility {
  public
  private
  restricted
}

Enum print_status {
  queued
  printing
  success
  failed
  cancelled
}

Enum notification_channel {
  partner
  operator
  admin
}

Enum notification_status {
  unread
  read
  archived
}

Enum audit_action {
  login
  logout
  payment
  voucher
  print
  upload
  delete
  update
  create
  download
  sync
}

Enum user_status {
  active
  suspended
  invited
  inactive
}

// =====================================================================
// MODULE: RBAC / IDENTITY & ACCESS
// =====================================================================

Table roles {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
  slug varchar(50) [not null, unique]
  description varchar(255)
  is_system boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Note: 'Super Admin, Admin, Partner Owner, Partner Manager, Operator'
}

Table permissions {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  slug varchar(100) [not null, unique]
  module varchar(50) [not null]
  description varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    module
  }
}

Table role_permissions {
  id bigint [pk, increment]
  role_id bigint [not null]
  permission_id bigint [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (role_id, permission_id) [unique]
  }
}

Table users {
  id bigint [pk, increment]
  partner_id bigint [null]
  role_id bigint [not null]
  name varchar(150) [not null]
  email varchar(150) [not null, unique]
  email_verified_at timestamp
  password varchar(255) [not null]
  phone varchar(30)
  avatar_path varchar(255)
  status user_status [not null, default: 'active']
  last_login_at timestamp
  last_login_ip varchar(45)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    role_id
    email [unique]
  }

  Note: 'partner_id NULL for Super Admin/Admin. Populated for Partner Owner, Partner Manager, Operator'
}

Table personal_access_tokens {
  id bigint [pk, increment]
  tokenable_type varchar(150) [not null]
  tokenable_id bigint [not null]
  name varchar(150) [not null]
  token varchar(64) [not null, unique]
  abilities text
  last_used_at timestamp
  expires_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    (tokenable_type, tokenable_id)
  }

  Note: 'Laravel Sanctum polymorphic token storage (users + devices)'
}

// =====================================================================
// MODULE: PARTNER / SUBSCRIPTION
// =====================================================================

Table subscription_plans {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  price decimal(15,2) [not null]
  billing_cycle varchar(20) [not null, default: 'monthly']
  max_booths int [not null, default: 1]
  max_devices int [not null, default: 1]
  max_operators int [not null, default: 5]
  features text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp
}

Table partners {
  id bigint [pk, increment]
  company_name varchar(150) [not null]
  brand_name varchar(150)
  slug varchar(150) [not null, unique]
  address text
  phone varchar(30)
  email varchar(150) [not null, unique]
  tax_number varchar(50)
  logo_path varchar(255)
  status partner_status [not null, default: 'trial']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    status
    slug [unique]
  }
}

Table partner_subscriptions {
  id bigint [pk, increment]
  partner_id bigint [not null]
  subscription_plan_id bigint [not null]
  status subscription_status [not null, default: 'pending']
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  auto_renew boolean [not null, default: true]
  cancelled_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    partner_id
    (partner_id, status)
  }
}

Table partner_monthly_reports {
  id bigint [pk, increment]
  partner_id bigint [not null]
  period_year int [not null]
  period_month int [not null]
  total_revenue decimal(18,2) [not null, default: 0]
  total_sessions int [not null, default: 0]
  total_customers int [not null, default: 0]
  total_vouchers_used int [not null, default: 0]
  total_qris_transactions int [not null, default: 0]
  total_prints int [not null, default: 0]
  total_downloads int [not null, default: 0]
  total_media int [not null, default: 0]
  generated_at timestamp [not null, default: `now()`]

  Indexes {
    (partner_id, period_year, period_month) [unique]
  }
}

Table partner_daily_stats {
  id bigint [pk, increment]
  partner_id bigint [not null]
  stat_date date [not null]
  total_revenue decimal(18,2) [not null, default: 0]
  total_sessions int [not null, default: 0]
  total_customers int [not null, default: 0]
  total_prints int [not null, default: 0]
  total_downloads int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (partner_id, stat_date) [unique]
  }

  Note: 'Feeds Partner Dashboard: daily revenue, sessions, prints, downloads'
}

// =====================================================================
// MODULE: BOOTH / DEVICE
// =====================================================================

Table booths {
  id bigint [pk, increment]
  partner_id bigint [not null]
  name varchar(150) [not null]
  location varchar(255)
  status booth_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    (partner_id, status)
  }
}

Table devices {
  id bigint [pk, increment]
  partner_id bigint [not null]
  booth_id bigint [null]
  device_key varchar(100) [not null, unique]
  device_uuid varchar(100) [not null, unique]
  device_name varchar(150) [not null]
  windows_uuid varchar(150)
  cpu_identifier varchar(150)
  mac_address varchar(50)
  app_version varchar(30)
  last_sync_at timestamp
  last_login_at timestamp
  status device_status [not null, default: 'pending']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    booth_id
    device_uuid [unique]
    device_key [unique]
  }

  Note: 'Only registered + active devices may authenticate the Electron App via API'
}

// =====================================================================
// MODULE: TEMPLATE / FILTER / CAMERA / PRINTER (MASTER + SNAPSHOT)
// =====================================================================

Table templates {
  id bigint [pk, increment]
  partner_id bigint [null]
  name varchar(150) [not null]
  preview_path varchar(255)
  thumbnail_path varchar(255)
  json_layout json [not null]
  psd_path varchar(255)
  png_path varchar(255)
  version int [not null, default: 1]
  status template_status [not null, default: 'draft']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    (partner_id, status)
  }

  Note: 'partner_id NULL = global template managed by Admin'
}

Table filters {
  id bigint [pk, increment]
  partner_id bigint [null]
  name varchar(150) [not null]
  lut_path varchar(255)
  brightness decimal(6,2) [not null, default: 0]
  contrast decimal(6,2) [not null, default: 0]
  saturation decimal(6,2) [not null, default: 0]
  sharpness decimal(6,2) [not null, default: 0]
  white_balance decimal(6,2) [not null, default: 0]
  intensity decimal(6,2) [not null, default: 100]
  version int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
  }
}

Table camera_profiles {
  id bigint [pk, increment]
  partner_id bigint [null]
  name varchar(150) [not null]
  iso varchar(20)
  shutter_speed varchar(20)
  aperture varchar(20)
  white_balance varchar(20)
  exposure varchar(20)
  focus_mode varchar(30)
  countdown_seconds int [not null, default: 3]
  burst_count int [not null, default: 1]
  image_quality varchar(20)
  live_view boolean [not null, default: true]
  version int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
  }
}

Table printer_profiles {
  id bigint [pk, increment]
  partner_id bigint [null]
  printer_name varchar(150) [not null]
  copies int [not null, default: 1]
  paper_size varchar(30) [not null]
  orientation varchar(20) [not null, default: 'portrait']
  auto_print boolean [not null, default: true]
  border boolean [not null, default: false]
  bleed decimal(6,2) [not null, default: 0]
  delay_ms int [not null, default: 0]
  version int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
  }
}

Table template_snapshots {
  id bigint [pk, increment]
  template_id bigint [not null]
  name varchar(150) [not null]
  preview_path varchar(255)
  thumbnail_path varchar(255)
  json_layout json [not null]
  psd_path varchar(255)
  png_path varchar(255)
  version int [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    template_id
  }

  Note: 'Immutable copy of Template at time of Event creation. Editing Template never affects past Events'
}

Table filter_snapshots {
  id bigint [pk, increment]
  filter_id bigint [not null]
  name varchar(150) [not null]
  lut_path varchar(255)
  brightness decimal(6,2) [not null]
  contrast decimal(6,2) [not null]
  saturation decimal(6,2) [not null]
  sharpness decimal(6,2) [not null]
  white_balance decimal(6,2) [not null]
  intensity decimal(6,2) [not null]
  version int [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    filter_id
  }
}

Table camera_snapshots {
  id bigint [pk, increment]
  camera_profile_id bigint [not null]
  iso varchar(20)
  shutter_speed varchar(20)
  aperture varchar(20)
  white_balance varchar(20)
  exposure varchar(20)
  focus_mode varchar(30)
  countdown_seconds int [not null]
  burst_count int [not null]
  image_quality varchar(20)
  live_view boolean [not null]
  version int [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    camera_profile_id
  }
}

Table printer_snapshots {
  id bigint [pk, increment]
  printer_profile_id bigint [not null]
  printer_name varchar(150) [not null]
  copies int [not null]
  paper_size varchar(30) [not null]
  orientation varchar(20) [not null]
  auto_print boolean [not null]
  border boolean [not null]
  bleed decimal(6,2) [not null]
  delay_ms int [not null]
  version int [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    printer_profile_id
  }
}

// =====================================================================
// MODULE: EVENT
// =====================================================================

Table events {
  id bigint [pk, increment]
  partner_id bigint [not null]
  booth_id bigint [not null]
  created_by bigint [not null]
  event_name varchar(150) [not null]
  event_code varchar(30) [not null, unique]
  template_snapshot_id bigint [not null]
  filter_snapshot_id bigint [not null]
  camera_snapshot_id bigint [not null]
  printer_snapshot_id bigint [not null]
  event_date date [not null]
  start_time time [not null]
  end_time time [not null]
  price decimal(15,2) [not null, default: 0]
  print_count_limit int [not null, default: 0]
  status event_status [not null, default: 'draft']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    booth_id
    event_code [unique]
    (partner_id, status)
  }

  Note: 'Operator only enters event_code; Desktop auto-downloads full snapshot configuration via API'
}

// =====================================================================
// MODULE: CUSTOMER / VOUCHER / PAYMENT
// =====================================================================

Table customers {
  id bigint [pk, increment]
  partner_id bigint [null]
  name varchar(150)
  phone varchar(30)
  email varchar(150)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    phone
    email
  }

  Note: 'Customer info is optional / anonymous walk-ins allowed'
}

Table voucher_packages {
  id bigint [pk, increment]
  partner_id bigint [null]
  name varchar(150) [not null]
  price decimal(15,2) [not null]
  persons int [not null, default: 1]
  captures int [not null, default: 1]
  print_count int [not null, default: 1]
  gif_included boolean [not null, default: false]
  video_included boolean [not null, default: false]
  template_id bigint [null]
  validity_days int [not null, default: 30]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
  }

  Note: 'template_id restricts voucher redemption to a specific Template'
}

Table vouchers {
  id bigint [pk, increment]
  partner_id bigint [not null]
  voucher_package_id bigint [not null]
  code varchar(50) [not null, unique]
  status voucher_status [not null, default: 'unused']
  expired_at timestamp [not null]
  generated_by bigint [not null]
  redeemed_by bigint [null]
  redeemed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    partner_id
    code [unique]
    (partner_id, status)
  }
}

Table payments {
  id bigint [pk, increment]
  partner_id bigint [not null]
  reference varchar(100) [not null, unique]
  gateway payment_gateway [not null]
  amount decimal(15,2) [not null]
  fee decimal(15,2) [not null, default: 0]
  net_amount decimal(15,2) [not null]
  status payment_status [not null, default: 'pending']
  voucher_id bigint [null]
  expired_at timestamp
  paid_at timestamp
  gateway_response json
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    partner_id
    reference [unique]
    (partner_id, status)
  }

  Note: 'voucher_id populated when gateway = voucher (redemption as payment method)'
}

// =====================================================================
// MODULE: PHOTO SESSION / MEDIA (CORE TRANSACTIONAL ENTITIES)
// =====================================================================

Table photo_sessions {
  id bigint [pk, increment]
  partner_id bigint [not null]
  booth_id bigint [not null]
  event_id bigint [null]
  device_id bigint [not null]
  operator_id bigint [not null]
  customer_id bigint [null]
  payment_id bigint [null]
  download_token varchar(64) [not null, unique]
  status session_status [not null, default: 'started']
  started_at timestamp [not null, default: `now()`]
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    booth_id
    event_id
    device_id
    download_token [unique]
    (partner_id, status)
    started_at
  }

  Note: 'Core transactional entity of the platform'
}

Table media {
  id bigint [pk, increment]
  photo_session_id bigint [not null]
  type media_type [not null]
  bucket varchar(150) [not null]
  object_key varchar(500) [not null]
  filename varchar(255) [not null]
  mime_type varchar(100) [not null]
  size_bytes bigint [not null, default: 0]
  checksum varchar(64) [not null]
  width int
  height int
  duration_seconds decimal(8,2)
  visibility media_visibility [not null, default: 'private']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    photo_session_id
    type
    (photo_session_id, type)
    checksum
  }

  Note: 'Never store permanent public URLs; only bucket + object_key (Cloudflare R2). Signed URLs generated on demand by Laravel'
}

// =====================================================================
// MODULE: DOWNLOAD / GALLERY
// =====================================================================

Table download_tokens {
  id bigint [pk, increment]
  photo_session_id bigint [not null, unique]
  token varchar(64) [not null, unique]
  download_count int [not null, default: 0]
  share_count int [not null, default: 0]
  expires_at timestamp [not null]
  last_download_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    token [unique]
    photo_session_id [unique]
  }

  Note: 'QR points to https://photo.domain.com/download/{token}. Laravel validates token before issuing signed R2 URL'
}

Table gallery_views {
  id bigint [pk, increment]
  photo_session_id bigint [not null]
  ip_address varchar(45)
  user_agent varchar(255)
  viewed_at timestamp [not null, default: `now()`]

  Indexes {
    photo_session_id
  }

  Note: 'Optional analytics log only. Gallery is a read-only projection of photo_sessions + media, never duplicates Media'
}

// =====================================================================
// MODULE: PRINT
// =====================================================================

Table printers {
  id bigint [pk, increment]
  partner_id bigint [not null]
  booth_id bigint [null]
  device_id bigint [null]
  name varchar(150) [not null]
  driver_name varchar(150)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  deleted_at timestamp

  Indexes {
    partner_id
    booth_id
    device_id
  }

  Note: 'Physical Windows printer registered per Booth/Device'
}

Table print_jobs {
  id bigint [pk, increment]
  partner_id bigint [not null]
  photo_session_id bigint [not null]
  printer_id bigint [not null]
  printer_snapshot_id bigint [null]
  copies int [not null, default: 1]
  status print_status [not null, default: 'queued']
  duration_ms int
  error_log text
  queued_at timestamp [not null, default: `now()`]
  started_at timestamp
  finished_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    partner_id
    photo_session_id
    printer_id
    (partner_id, status)
  }

  Note: 'Combined Print Queue + Print History via status lifecycle (queued -> printing -> success/failed/cancelled)'
}

// =====================================================================
// MODULE: ADMIN DASHBOARD STATS
// =====================================================================

Table admin_daily_stats {
  id bigint [pk, increment]
  stat_date date [not null, unique]
  total_partners int [not null, default: 0]
  total_booths int [not null, default: 0]
  total_devices int [not null, default: 0]
  total_events int [not null, default: 0]
  total_sessions int [not null, default: 0]
  total_payments int [not null, default: 0]
  total_media int [not null, default: 0]
  total_print_jobs int [not null, default: 0]
  total_uploads int [not null, default: 0]
  total_downloads int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    stat_date [unique]
  }
}

// =====================================================================
// MODULE: AUDIT LOG / NOTIFICATION
// =====================================================================

Table audit_logs {
  id bigint [pk, increment]
  partner_id bigint [null]
  user_id bigint [null]
  action audit_action [not null]
  subject_type varchar(150)
  subject_id bigint
  description varchar(500)
  ip_address varchar(45)
  user_agent varchar(255)
  metadata json
  created_at timestamp [not null, default: `now()`]

  Indexes {
    partner_id
    user_id
    action
    (subject_type, subject_id)
    created_at
  }
}

Table notifications {
  id bigint [pk, increment]
  partner_id bigint [null]
  recipient_type notification_channel [not null]
  recipient_id bigint [not null]
  title varchar(200) [not null]
  message text [not null]
  status notification_status [not null, default: 'unread']
  data json
  read_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Indexes {
    partner_id
    (recipient_type, recipient_id)
    status
  }
}

// =====================================================================
// RELATIONSHIPS (FOREIGN KEYS)
// =====================================================================

// RBAC
Ref: role_permissions.role_id > roles.id [delete: cascade]
Ref: role_permissions.permission_id > permissions.id [delete: cascade]
Ref: users.role_id > roles.id [delete: restrict]
Ref: users.partner_id > partners.id [delete: cascade]

// Partner / Subscription
Ref: partner_subscriptions.partner_id > partners.id [delete: cascade]
Ref: partner_subscriptions.subscription_plan_id > subscription_plans.id [delete: restrict]
Ref: partner_monthly_reports.partner_id > partners.id [delete: cascade]
Ref: partner_daily_stats.partner_id > partners.id [delete: cascade]

// Booth / Device
Ref: booths.partner_id > partners.id [delete: cascade]
Ref: devices.partner_id > partners.id [delete: cascade]
Ref: devices.booth_id > booths.id [delete: set null]

// Template / Filter / Camera / Printer masters
Ref: templates.partner_id > partners.id [delete: cascade]
Ref: filters.partner_id > partners.id [delete: cascade]
Ref: camera_profiles.partner_id > partners.id [delete: cascade]
Ref: printer_profiles.partner_id > partners.id [delete: cascade]

// Snapshots
Ref: template_snapshots.template_id > templates.id [delete: restrict]
Ref: filter_snapshots.filter_id > filters.id [delete: restrict]
Ref: camera_snapshots.camera_profile_id > camera_profiles.id [delete: restrict]
Ref: printer_snapshots.printer_profile_id > printer_profiles.id [delete: restrict]

// Event
Ref: events.partner_id > partners.id [delete: cascade]
Ref: events.booth_id > booths.id [delete: restrict]
Ref: events.created_by > users.id [delete: restrict]
Ref: events.template_snapshot_id > template_snapshots.id [delete: restrict]
Ref: events.filter_snapshot_id > filter_snapshots.id [delete: restrict]
Ref: events.camera_snapshot_id > camera_snapshots.id [delete: restrict]
Ref: events.printer_snapshot_id > printer_snapshots.id [delete: restrict]

// Customer / Voucher / Payment
Ref: customers.partner_id > partners.id [delete: set null]
Ref: voucher_packages.partner_id > partners.id [delete: cascade]
Ref: voucher_packages.template_id > templates.id [delete: set null]
Ref: vouchers.partner_id > partners.id [delete: cascade]
Ref: vouchers.voucher_package_id > voucher_packages.id [delete: restrict]
Ref: vouchers.generated_by > users.id [delete: restrict]
Ref: vouchers.redeemed_by > users.id [delete: set null]
Ref: payments.partner_id > partners.id [delete: cascade]
Ref: payments.voucher_id > vouchers.id [delete: set null]

// Photo Session / Media
Ref: photo_sessions.partner_id > partners.id [delete: cascade]
Ref: photo_sessions.booth_id > booths.id [delete: restrict]
Ref: photo_sessions.event_id > events.id [delete: set null]
Ref: photo_sessions.device_id > devices.id [delete: restrict]
Ref: photo_sessions.operator_id > users.id [delete: restrict]
Ref: photo_sessions.customer_id > customers.id [delete: set null]
Ref: photo_sessions.payment_id > payments.id [delete: set null]
Ref: media.photo_session_id > photo_sessions.id [delete: cascade]

// Download / Gallery
Ref: download_tokens.photo_session_id > photo_sessions.id [delete: cascade]
Ref: gallery_views.photo_session_id > photo_sessions.id [delete: cascade]

// Print
Ref: printers.partner_id > partners.id [delete: cascade]
Ref: printers.booth_id > booths.id [delete: set null]
Ref: printers.device_id > devices.id [delete: set null]
Ref: print_jobs.partner_id > partners.id [delete: cascade]
Ref: print_jobs.photo_session_id > photo_sessions.id [delete: cascade]
Ref: print_jobs.printer_id > printers.id [delete: restrict]
Ref: print_jobs.printer_snapshot_id > printer_snapshots.id [delete: set null]

// Audit / Notification
Ref: audit_logs.partner_id > partners.id [delete: set null]
Ref: audit_logs.user_id > users.id [delete: set null]
Ref: notifications.partner_id > partners.id [delete: cascade]
